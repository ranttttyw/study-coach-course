# demo 无需密钥。online 才调用真实模型。
COACH_MODE=demo
OPENAI_API_KEY=
# 其他兼容接口通常填写以 /v1 结尾的服务地址；留空时应用会显式使用 OpenAI 官方地址。
OPENAI_BASE_URL=
COACH_MODEL=gpt-4o-mini
COACH_DB_PATH=data/study_coach.db
COACH_RECENT_LIMIT=6
COACH_MAX_TOOL_STEPS=4
COACH_UPLOAD_DIR=data/uploads
COACH_MAX_PPT_MB=30
COACH_MAX_PPT_SLIDES=100
COACH_MAX_DOCUMENTS_PER_USER=10
COACH_MATERIAL_RESULT_LIMIT=3
COACH_MATERIAL_CHARS_PER_RESULT=1200
